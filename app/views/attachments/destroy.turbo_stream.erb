<% if @champ %>
  <%= render partial: 'shared/dossiers/update_champ', locals: { full: true, champ: @champ } %>
  <%= render partial: 'champs/repetition/clear_error', locals: { champs: [@champ] } %>
  <%= render partial: 'shared/dossiers/update_footer', locals: { dossier: @champ.dossier } %>
<% else %>
  <%= turbo_stream.replace dom_id(@attachment, :persisted_row) do %>
    <%= render Attachment::FileFieldComponent.new(context: Attachment::Context.new(**@attachment_options), drop_zone: :none) %>
  <% end %>
<% end %>

<% deleted_filename = (@attachment&.blob&.filename || params[:attachment] || '') %>
<% focusable_input_id = @champ ? @champ.focusable_input_id : dom_id(@attachment.record, @attachment.name) %>

<%= turbo_stream.update "#{focusable_input_id}-aria-live", t('activerecord.models.attachment.successfully_deleted_without_anchor', attachment: deleted_filename) %>
<%= turbo_stream.focus focusable_input_id %>
