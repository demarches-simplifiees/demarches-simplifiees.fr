<% if etablissement.diffusable_commercialement == false %>
  <p>
    <%= t('warning_for_private_info', scope: 'views.shared.dossiers.identite_entreprise', siret: pretty_siret(etablissement.siret)) %>
  </p>
<% end %>

<dl class="fr-pl-0">
  <div class="champ-row">
    <dt class="champ-label"><%= label('.denomination') %></dt>

    <dd class="champ-content">
      <%= raison_sociale_or_name(etablissement) %>
    </dd>
  </div>

  <div class="champ-row">
    <dt class="champ-label"><%= label('.siret') %></dt>
    <dd class="champ-content"><%= pretty_siret(etablissement.siret) %></dd>
  </div>
</dl>
